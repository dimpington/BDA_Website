---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const objects = await getCollection("digital-objects");
const collections = await getCollection("collections");

const sortedObjects = objects.sort((a, b) =>
  a.data.fwxId.localeCompare(b.data.fwxId)
);
---

<Layout
  title="Forgotten Web Exchange | Bureau of Digital Antiquities"
  description="Browse the Forgotten Web Exchange, the Bureau of Digital Antiquities public catalogue of historically significant Digital Objects."
>
  <section class="catalogue-intro">
    <p class="section-label">Public Catalogue</p>

    <div class="fwx-masthead">
      <img
        src="/images/fwx-logo.png"
        alt="Forgotten Web Exchange"
        class="fwx-logo"
      />

      <div class="fwx-masthead__text">
        <h1>Forgotten Web Exchange</h1>

        <p class="catalogue-lead">
          The Forgotten Web Exchange provides public access to catalogued
          Digital Objects held by the Bureau of Digital Antiquities.
        </p>
      </div>
    </div>

    <dl class="catalogue-reference">
      <div>
        <dt>Document Reference</dt>
        <dd>BDA-FWX-CATALOGUE-001</dd>
      </div>

      <div>
        <dt>Release Status</dt>
        <dd>Public Release</dd>
      </div>

      <div>
        <dt>Catalogue Records</dt>
        <dd>{sortedObjects.length}</dd>
      </div>
    </dl>
  </section>

  <section class="catalogue-register" aria-labelledby="catalogue-records">
    <div class="catalogue-register__heading">
      <div>
        <p class="section-label">Register</p>
        <h2 id="catalogue-records">Digital Object Records</h2>
      </div>

      <p>
        Ordered by permanent FWX identifier
      </p>
    </div>

<form
  class="catalogue-search"
  action="/fwx"
  method="get"
  role="search"
>
  <label for="fwx-catalogue-query">
    Search Public Catalogue
  </label>

  <div class="catalogue-search__controls">
    <input
      id="fwx-catalogue-query"
      name="q"
      type="search"
      placeholder="Title, FWX ID, object type, status..."
    />

    <button type="submit">
      Search Catalogue
    </button>
  </div>
</form>

<div class="catalogue-filters">
  <div class="catalogue-filter">
    <label for="object-type-filter">
      Object Type
    </label>

    <select id="object-type-filter" name="type">
      <option value="">All object types</option>

      {
        [...new Set(objects.map((object) => object.data.objectType))]
          .sort()
          .map((type) => (
            <option value={type.toLowerCase()}>
              {type}
            </option>
          ))
      }
    </select>
  </div>

  <div class="catalogue-filter">
    <label for="preservation-status-filter">
      Preservation Status
    </label>

    <select id="preservation-status-filter" name="preservation">
      <option value="">All preservation statuses</option>

      {
        [...new Set(objects.map((object) => object.data.preservationStatus))]
          .sort()
          .map((status) => (
            <option value={status.toLowerCase()}>
              {status}
            </option>
          ))
      }
    </select>
  </div>

  <div class="catalogue-filter">
    <label for="operational-status-filter">
      Operational Status
    </label>

    <select id="operational-status-filter" name="operational">
      <option value="">All operational statuses</option>

      {
        [...new Set(objects.map((object) => object.data.operationalStatus))]
          .sort()
          .map((status) => (
            <option value={status.toLowerCase()}>
              {status}
            </option>
          ))
      }
    </select>
  </div>

  <div class="catalogue-filter">
    <label for="classification-filter">
      Classification
    </label>

    <select id="classification-filter" name="classification">
      <option value="">All classifications</option>

      {
        [...new Set(objects.map((object) => object.data.classification))]
          .sort()
          .map((classification) => (
            <option value={classification.toLowerCase()}>
              {classification}
            </option>
          ))
      }
    </select>
  </div>

<div class="catalogue-filter catalogue-filter--collection">
  <label for="collection-filter">
    Collection
  </label>

  <select id="collection-filter" name="collection">
    <option value="">All collections</option>

    {
      collections
        .sort((a, b) => a.data.title.localeCompare(b.data.title))
        .map((collection) => (
          <option value={collection.data.id.toLowerCase()}>
            {collection.data.title}
          </option>
        ))
    }
  </select>
</div>

<div class="catalogue-filter">
  <label for="publication-period-filter">
    First Publication
  </label>

  <select id="publication-period-filter" name="period">
    <option value="">All periods</option>
    <option value="pre-1995">Before 1995</option>
    <option value="1995-1999">1995–1999</option>
    <option value="2000-2004">2000–2004</option>
    <option value="2005-2009">2005–2009</option>
    <option value="2010-2014">2010–2014</option>
    <option value="2015-2019">2015–2019</option>
    <option value="2020-present">2020–present</option>
  </select>
</div>

<div class="catalogue-filter">
  <label for="sort-filter">
    Order Records By
  </label>

  <select id="sort-filter" name="sort">
    <option value="fwx-id">FWX ID</option>
    <option value="title">Title</option>
    <option value="first-published">First Publication</option>
    <option value="last-verified">Last Verification</option>
  </select>
</div>

</div>

<div
  id="catalogue-search-status"
  class="catalogue-search-status"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  hidden
>

  <p>
    <strong>Catalogue query:</strong>
    <span id="catalogue-search-query"></span>
  </p>

  <p>
    <span id="catalogue-search-count"></span>
    ·
    <a href="/fwx">Clear search &amp; filters</a>
  </p>
</div>

    <div class="catalogue-table-wrapper">
      <table class="catalogue-table">
        <thead>
          <tr>
            <th scope="col">FWX ID</th>
            <th scope="col">Title</th>
            <th scope="col">Object Type</th>
            <th scope="col">Operational Status</th>
            <th scope="col">Preservation Status</th>
            <th scope="col">Classification</th>
          </tr>
        </thead>

          <tbody>
          {
            sortedObjects.map((object) => {
              const searchText = [
                object.data.fwxId,
                object.data.title,
                object.data.summary,
                object.data.objectType,
                object.data.operationalStatus,
                object.data.preservationStatus,
                object.data.classification,
              ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase();

              const objectCollections = collections
              .filter((collection) =>
                collection.data.featuredObjects.includes(object.data.fwxId)
              )
              .map((collection) => collection.data.id.toLowerCase())
              .join(" ");

              const publicationYear = object.data.firstPublished
              ? object.data.firstPublished.slice(0, 4)
              : "";

              const sortTitle = object.data.title.toLowerCase();
              const sortFirstPublished = object.data.firstPublished ?? "";
              const sortLastVerified = object.data.lastVerified ?? "";

              return (
                <tr
                  data-search={searchText}
                  data-object-type={object.data.objectType.toLowerCase()}
                  data-preservation-status={object.data.preservationStatus.toLowerCase()}
                  data-operational-status={object.data.operationalStatus.toLowerCase()}
                  data-classification={object.data.classification.toLowerCase()}
                  data-collections={objectCollections}
                  data-publication-year={publicationYear}
                  data-sort-title={sortTitle}
                  data-sort-first-published={sortFirstPublished}
                  data-sort-last-verified={sortLastVerified}
                >
                  <td class="catalogue-id">
                    <a href={`/fwx/${object.data.fwxId}`}>
                      {object.data.fwxId}
                    </a>
                  </td>

                  <td class="catalogue-title">
                    <a href={`/fwx/${object.data.fwxId}`}>
                      {object.data.title}
                    </a>

                    <p>{object.data.summary}</p>
                  </td>

                  <td>{object.data.objectType}</td>

                  <td>
                    <span class="record-badge">
                      {object.data.operationalStatus}
                    </span>
                  </td>

                  <td>
                    <span class="record-badge">
                      {object.data.preservationStatus}
                    </span>
                  </td>

                  <td>
                    <span class="record-badge record-badge--classification">
                      {object.data.classification}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
            <div
            id="catalogue-no-results"
            class="catalogue-no-results"
            role="status"
            aria-live="polite"
            hidden
          >
        <p><strong>No records located</strong></p>

        <p>
          No public catalogue records correspond to the supplied search criteria.
        </p>

        <p>
          <a href="/fwx">Return to the complete catalogue</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script is:inline src="/scripts/fwx-catalogue.js"></script>