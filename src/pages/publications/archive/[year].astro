---
import { getCollection } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import Layout from "../../../layouts/Layout.astro";
import PublicationRegister from "../../../components/PublicationRegister.astro";

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  const years = [...new Set(publications.map((entry) => entry.data.published.slice(0, 4)))];
  return years.map((year) => ({ params: { year }, props: { year, publications } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { year, publications } = Astro.props;
---

<Layout title={`${year} Publication Archive | Bureau of Digital Antiquities`}>
  <section class="page-header">
    <p class="section-label">Official Publications · Annual Archive</p>
    <h1>Publication Archive: {year}</h1>
    <p class="page-introduction">Bureau publications issued in {year}, ordered by publication date. Document status is shown on each record.</p>
  </section>
  <PublicationRegister publications={publications} year={year} />
</Layout>
