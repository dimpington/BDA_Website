---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import CollectionCard from "../../components/CollectionCard.astro";

const collections = await getCollection("collections");

const sortedCollections = collections.sort((a, b) =>
  b.data.published.localeCompare(a.data.published)
);
---

<Layout title="Collections | Bureau of Digital Antiquities">
  <section class="page-header">
    <p class="section-label">Curated Exhibitions</p>

    <h1>Collections</h1>

    <p class="page-introduction">
      Bureau Collections bring together related Digital Objects and official
      publications to document broader historical, cultural and technical
      developments in digital heritage.
    </p>
  </section>

  <section class="record-section">
    <div class="record-section-heading">
      <p class="section-label">Collection Register</p>

      <h2>Available Collections</h2>
    </div>

    <div class="related-records">
      {
        sortedCollections.map((collection) => (
          <CollectionCard collection={collection} />
        ))
      }
    </div>
    {sortedCollections.length === 0 && <p>No collections are currently available in the public register.</p>}
  </section>
</Layout>
