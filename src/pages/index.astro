---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const digitalObjectsCollection = await getCollection("digital-objects");
const bureauDepartments = await getCollection("departments");
const publicationsCollection = await getCollection("publications");
const collectionsCollection = await getCollection("collections");
const noticesCollection = await getCollection("notices");

const recentlyCatalogued = [...digitalObjectsCollection]
  .sort((a, b) =>
    (b.data.lastVerified ?? "").localeCompare(
      a.data.lastVerified ?? ""
    )
  )
  .slice(0, 4);

const latestPublications = [...publicationsCollection]
  .sort((a, b) =>
    b.data.published.localeCompare(a.data.published)
  )
  .slice(0, 3);

const featuredObject =
  digitalObjectsCollection.find(
    (object) => object.data.featured
  ) ?? digitalObjectsCollection[0];

const latestNotice =
  [...noticesCollection]
    .sort((a, b) => b.data.published.localeCompare(a.data.published))[0];

---

<Layout
  title="Bureau of Digital Antiquities"
  description="Search the Forgotten Web Exchange and access public records, publications, and institutional information from the Bureau of Digital Antiquities."
>
  <div class="home-page">
    <section class="catalogue-hero" aria-labelledby="catalogue-heading">
      <div class="catalogue-hero__content">
        <p class="section-kicker">Forgotten Web Exchange</p>

        <h2 id="catalogue-heading">Search the Public Catalogue</h2>

        <p class="catalogue-hero__introduction">
          Search published records of historically significant websites,
          digital communities, network services, documents, software environments,
          and recovered digital artefacts.
        </p>

        <form class="catalogue-search" action="/fwx" method="get" role="search">
          <label for="catalogue-query">
            Search by title, object number, subject, organisation, or date
          </label>

          <div class="catalogue-search__controls">
            <input
              id="catalogue-query"
              name="q"
              type="search"
              placeholder="Example: FWX-000143 or personal homepage"
            />

            <button type="submit">Search catalogue</button>
          </div>
        </form>

        <nav class="catalogue-links" aria-label="Catalogue browsing options">
          <a href="/fwx">Browse all public records</a>
          <a href="/collections">Browse by collection</a>
          <a href="/fwx?status=cataloged">Recently catalogued</a>
        </nav>
      </div>
      
      <aside class="public-information" aria-labelledby="public-information-heading">
        <p class="public-information__label" id="public-information-heading">
          Public Access System
        </p>

        <dl>
<div>
  <dt>Public Records</dt>
  <dd>{digitalObjectsCollection.length}</dd>
</div>

<div>
  <dt>Departments</dt>
  <dd>{bureauDepartments.length}</dd>
</div>

<div>
  <dt>Publications</dt>
  <dd>{publicationsCollection.length}</dd>
</div>

<div>
  <dt>Collections</dt>
  <dd>{collectionsCollection.length}</dd>
</div>

<div>
  <dt>Record Authority</dt>
  <dd>Records &amp; Provenance Division</dd>
</div>
        </dl>
      </aside>
    </section>

    <section class="bureau-notice" aria-labelledby="bureau-notice-heading">
      <div class="bureau-notice__heading">
        <span>Bureau Notice</span>
        <span>{latestNotice.data.id}</span>
      </div>

      <div class="bureau-notice__body">
        <h2 id="bureau-notice-heading">
          {latestNotice.data.title}
        </h2>

        <p>{latestNotice.data.summary}</p>

<p>
  <a href={`/notices/${latestNotice.data.id}`}>
    View Notice {latestNotice.data.id} →
  </a>
</p>
      </div>
    </section>

    <div class="home-grid">
      <section class="record-panel featured-record" aria-labelledby="featured-record-heading">
        <header class="panel-heading">
          <div>
            <p class="section-kicker">Curatorial Selection</p>
            <h2 id="featured-record-heading">Featured Digital Object</h2>
          </div>

          <span class="record-number">
  {featuredObject.data.fwxId}
</span>
        </header>

        <div class="featured-record__image" aria-hidden="true">
          <div class="browser-fragment">
            <div class="browser-fragment__bar">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="browser-fragment__content">
              <span>WELCOME TO MY HOMEPAGE</span>
              <small>Best viewed at 800 × 600</small>
            </div>
          </div>
        </div>

        <div class="featured-record__content">
          <p class="record-type">
  {featuredObject.data.objectType}
</p>

          <h3>{featuredObject.data.title}</h3>

          <p>
  {featuredObject.data.summary}
</p>

          <dl class="record-metadata">
            <div>
              <dt>Original publication</dt>
              <dd>{featuredObject.data.firstPublished}</dd>
            </div>

            <div>
              <dt>Preservation status</dt>
              <dd>
  <span class="status-label">
    {featuredObject.data.preservationStatus}
  </span>
</dd>
            </div>

<div>
  <dt>Operational Status</dt>
  <dd>{featuredObject.data.operationalStatus}</dd>
</div>

<div>
  <dt>Classification</dt>
  <dd>{featuredObject.data.classification}</dd>
</div>
          </dl>

          <a class="text-button" href={`/fwx/${featuredObject.data.fwxId}`}>
            View catalogue record
          </a>
        </div>
      </section>

      <section class="record-panel recent-records" aria-labelledby="recent-records-heading">
        <header class="panel-heading">
          <div>
            <p class="section-kicker">Catalogue Activity</p>
            <h2 id="recent-records-heading">Recently Catalogued</h2>
          </div>
        </header>

        <ol class="record-list">
  {
    recentlyCatalogued.map((record) => (
      <li>
        <a href={`/fwx/${record.data.fwxId}`}>
          <span class="record-list__id">
            {record.data.fwxId}
          </span>

          <span class="record-list__title">
            {record.data.title}
          </span>

          <span class="record-list__meta">
            {record.data.objectType}
            {record.data.firstPublished && ` · ${record.data.firstPublished}`}
          </span>
        </a>
      </li>
    ))
  }
</ol>

        <a class="panel-footer-link" href="/fwx">
          View all public catalogue records
        </a>
      </section>
    </div>

    <section class="publications-section" aria-labelledby="publications-heading">
      <header class="section-heading">
        <div>
          <p class="section-kicker">Bureau Publications</p>
          <h2 id="publications-heading">Latest Publications</h2>
        </div>

        <a href="/publications">Publication index</a>
      </header>

      <div class="publication-list">
        {
          latestPublications.map((publication) => (
<article class="publication-entry">
  <div class="publication-entry__reference">
    <span>{publication.data.type}</span>
    <strong>{publication.data.id}</strong>
  </div>

  <div class="publication-entry__body">
    <h3>
      <a href={`/publications/${publication.data.id}`}>
        {publication.data.title}
      </a>
    </h3>

    <p>Issued {publication.data.published}</p>
  </div>

  <span class="publication-entry__format">
    Public
  </span>
</article>
          ))
        }
      </div>
    </section>

    <section
      class="departments-section"
      id="departments"
      aria-labelledby="departments-heading"
    >
      <header class="section-heading">
        <div>
          <p class="section-kicker">Organisation</p>
          <h2 id="departments-heading">Departments and Offices</h2>
        </div>

        <a href="/organisation">Organisation directory</a>
      </header>

     <div class="department-grid">
  {
    bureauDepartments.map((department) => (
      <article class="department-entry">
        <span
          class="department-entry__marker"
          aria-hidden="true"
        ></span>

        <div>
          <h3>
            <a href={`/departments/${department.data.id}`}>
              {department.data.name}
            </a>
          </h3>

          <p>{department.data.summary}</p>
        </div>
      </article>
    ))
  }
</div>
    </section>

    <section class="about-bureau" aria-labelledby="about-bureau-heading">
      <div class="about-bureau__date">
        <span>Established</span>
        <strong>1998</strong>
      </div>

      <div class="about-bureau__content">
        <p class="section-kicker">Institutional Mandate</p>

        <h2 id="about-bureau-heading">
          Preserving the documentary record of the early public web
        </h2>

        <p>
          The Bureau of Digital Antiquities identifies, documents, assesses,
          and preserves historically significant digital heritage. Its holdings
          include websites, network services, digital publications, software
          environments, and supporting records.
        </p>

        <a class="text-button" href="/about">Read about the Bureau</a>
      </div>
    </section>
  </div>
</Layout>
