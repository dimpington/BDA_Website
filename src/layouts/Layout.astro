---
import "../styles/global.css";

const {
  title = "Bureau of Digital Antiquities",
  description = "The public portal of the Bureau of Digital Antiquities."
} = Astro.props;

const currentPath = Astro.url.pathname;

const navigation = [
  { href: "/", label: "Home" },
  { href: "/fwx", label: "FWX Catalogue" },
  { href: "/publications", label: "Publications" },
  { href: "/collections", label: "Collections" },
  { href: "/about", label: "About the Bureau" }
];

const isCurrentPage = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>

    <div class="site-shell">
      <div class="utility-bar">
        <div class="utility-bar__inner">
          <span>Official public portal</span>

          <span class="utility-bar__reference">
            BDA-WEB-PUBLIC
          </span>
        </div>
      </div>

      <header class="site-header">
        <a
          class="bureau-identity"
          href="/"
          aria-label="Bureau of Digital Antiquities home"
        >
          <img
            class="bureau-logo"
            src="/images/BDA_Emblem_1.png"
            alt=""
            width="161"
            height="161"
          />

          <div class="bureau-identity__text">
            <p class="bureau-kicker">
              Department of Internet Archaeology
            </p>

            <h1 class="site-title">
              Bureau of Digital Antiquities
            </h1>

            <p class="site-subtitle">
              Preserving historically significant digital heritage since 1998.
            </p>

            <p class="site-reference">
              Public Records and Research Administration
            </p>
          </div>
        </a>
      </header>

      <nav class="site-nav" aria-label="Primary navigation">
        <div class="site-nav__inner">
          {
            navigation.map((item) => {
              const isCurrent = isCurrentPage(item.href);

              return (
                <a
                  href={item.href}
                  class:list={{ "is-current": isCurrent }}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </div>
      </nav>

      <main class="site-main" id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-grid">
          <section>
            <h2>Bureau of Digital Antiquities</h2>

            <p>
              Public access portal for preserved digital records,
              institutional publications, and catalogue information.
            </p>
          </section>

          <section>
            <h2>Public Resources</h2>

            <ul>
              <li>
                <a href="/fwx">Search the FWX Catalogue</a>
              </li>

              <li>
                <a href="/collections">Browse Collections</a>
              </li>

              <li>
                <a href="/publications">View Publications</a>
              </li>
            </ul>
          </section>

          <section>
            <h2>Institutional Information</h2>

            <ul>
              <li>
                <a href="/about">About the Bureau</a>
              </li>

              <li>
                <a href="/about#departments">
                  Departments and Offices
                </a>
              </li>

              <li>
                <a href="/about#policies">
                  Public Access Policies
                </a>
              </li>
            </ul>
          </section>
        </div>

        <div class="footer-record">
          <span>Document ID: BDA-WEB-001</span>
          <span>Status: Public Release</span>
          <span>Forgotten Web Exchange · Public Portal</span>
        </div>
      </footer>
    </div>
  </body>
</html>