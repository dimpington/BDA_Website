---
import "../styles/global.css";

const {
  title = "Bureau of Digital Antiquities",
  description = "The public portal of the Bureau of Digital Antiquities."
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/images/social/bda-og-default.png", Astro.site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Bureau of Digital Antiquities",
  alternateName: "BDA",
  url: "https://digitalantiquities.org",
  logo: "https://digitalantiquities.org/images/bda-emblem.png",
  foundingDate: "1998",
  description:
    "A public institution dedicated to the identification, documentation and preservation of historically significant Digital Objects."
};

const navigation = [
  { href: "/", label: "Home" },
  { href: "/fwx", label: "FWX Catalogue" },
  { href: "/organisation", label: "Organisation" },
  { href: "/publications", label: "Publications" },
  { href: "/collections", label: "Collections" },
  { href: "/about", label: "About the Bureau" }
];

const isCurrentPage = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bureau of Digital Antiquities" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:alt"
      content="Bureau of Digital Antiquities — Preserving historically significant digital heritage"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="Bureau of Digital Antiquities — Preserving historically significant digital heritage"
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicons/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicons/apple-touch-icon.png" />

    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#17324a" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <title>{title}</title>
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>

    <div class="site-shell">
      <div class="utility-bar">
        <div class="utility-bar__inner">
          <span>Official public portal</span>

          <span class="utility-bar__reference">
            BDA-WEB-PUBLIC
          </span>
        </div>
      </div>

      <header class="site-header">
        <a
          class="bureau-identity"
          href="/"
          aria-label="Bureau of Digital Antiquities home"
        >
          <img
            class="bureau-logo"
            src="/images/bda-emblem.png"
            alt=""
            width="256"
            height="245"
          />

          <div class="bureau-identity__text">
            <p class="bureau-kicker">
              Department of Internet Archaeology
            </p>

            <p class="site-title">
              Bureau of Digital Antiquities
            </p>

            <p class="site-subtitle">
              Preserving historically significant digital heritage since 1998.
            </p>

            <p class="site-reference">
              Public Records and Research Administration
            </p>
          </div>
        </a>
      </header>

      <nav class="site-nav" aria-label="Primary navigation">
        <div class="site-nav__inner">
          {
            navigation.map((item) => {
              const isCurrent = isCurrentPage(item.href);

              return (
                <a
                  href={item.href}
                  class:list={{ "is-current": isCurrent }}
                  aria-current={isCurrent ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </div>
      </nav>

      <main class="site-main" id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-grid">
          <section>
            <h2>Bureau of Digital Antiquities</h2>

            <p>
              Public access portal for preserved digital records,
              institutional publications, and catalogue information.
            </p>
          </section>

          <section>
            <h2>Public Resources</h2>

            <ul>
              <li>
                <a href="/fwx">Search the FWX Catalogue</a>
              </li>

              <li>
                <a href="/collections">Browse Collections</a>
              </li>

              <li>
                <a href="/publications">View Publications</a>
              </li>
            </ul>
          </section>

          <section>
            <h2>Institutional Information</h2>

            <ul>
              <li>
                <a href="/about">About the Bureau</a>
              </li>

              <li>
                <a href="/organisation">
                  Departments and Offices
                </a>
              </li>

              <li>
                <a href="/privacy">
                  Privacy and Public Access
                </a>
              </li>

              <li>
                <a href="mailto:contact@digitalantiquities.org">
                  Contact the Bureau
                </a>
              </li>

              <li>
                <a href="mailto:security@digitalantiquities.org">
                  Report a Security Issue
                </a>
              </li>
            </ul>
          </section>
        </div>

        <div class="footer-record">
          <span>Document ID: BDA-WEB-001</span>
          <span>Status: Public Release</span>
          <span>Forgotten Web Exchange · Public Portal</span>
        </div>
      </footer>
    </div>
  </body>
</html>