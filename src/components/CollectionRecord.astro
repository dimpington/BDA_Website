---
import type { CollectionEntry } from "astro:content";
import { getCollectionDetails } from "../lib/collections";
import CollectionCard from "./CollectionCard.astro";
import PublicationCard from "./PublicationCard.astro";

interface Props {
  collection: CollectionEntry<"collections">;
}

const { collection } = Astro.props;

const {
  id,
  title,
  summary,
  curator,
  published,
  status,
  tags = [],
} = collection.data;

const {
  curator: curatorDepartment, keyObject, chronology,
  resolvedObjects, resolvedPublications, resolvedCollections,
  missingObjects, missingPublications, missingCollections,
} = await getCollectionDetails(collection);
---

<article class="collection-record">
  <header class="collection-record__header">
    <p class="section-label">Curated Bureau Collection</p>

    <p class="collection-record__id">{id}</p>

    <h1>{title}</h1>

    <p class="collection-record__summary">
      {summary}
    </p>

    <dl class="fwx-document-control">
      <div>
        <dt>Collection ID</dt>
        <dd>{id}</dd>
      </div>

      <div>
        <dt>Status</dt>
        <dd>{status}</dd>
      </div>

      <div>
        <dt>Curator</dt>
        <dd>{curatorDepartment ? <a href={`/departments/${curatorDepartment.id}`}>{curatorDepartment.data.name}</a> : curator}</dd>
      </div>

      <div>
        <dt>Published</dt>
        <dd>{published}</dd>
      </div>
      <div>
        <dt>Digital Objects</dt>
        <dd>{resolvedObjects.length}</dd>
      </div>
      <div>
        <dt>Publications</dt>
        <dd>{resolvedPublications.length}</dd>
      </div>
    </dl>
    {keyObject && (
      <figure class="record-preview__figure">
        <img class="record-preview__image" src={keyObject.data.previewImage}
          alt={`Preview of ${keyObject.data.title}, a member of this collection`}
          width="1600" height="900" />
        <figcaption>Collection key image: <a href={`/fwx/${keyObject.data.fwxId}`}>{keyObject.data.title}</a> ({keyObject.data.fwxId})</figcaption>
      </figure>
    )}
  </header>

  <section
    class="record-section record-body"
    aria-labelledby="collection-documentation"
  >
    <div class="record-section-heading">
      <p class="section-label">Collection Documentation</p>

      <h2 id="collection-documentation">
        Curatorial Record
      </h2>
    </div>

    <div class="record-prose">
      <slot />
    </div>
  </section>

  {chronology.length > 0 && (
    <section class="record-section" aria-labelledby="collection-chronology">
      <div class="record-section-heading">
        <p class="section-label">Collection Chronology</p>
        <h2 id="collection-chronology">Origins of the Digital Objects</h2>
      </div>
      <p>First-publication dates recorded in FWX, from earliest to latest. Date precision follows each record.</p>
      <ol class="collection-timeline">
        {chronology.map(({ date, record }) => (
          <li>
            <span class="collection-timeline__date">{date}</span>
            <div>
              <a href={`/fwx/${record.data.fwxId}`}>{record.data.title}</a>
              <p>{record.data.fwxId} · First published</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

    <section
      class="record-section"
      aria-labelledby="featured-digital-objects"
    >
      <div class="record-section-heading">
        <p class="section-label">Collection Holdings</p>

        <h2 id="featured-digital-objects">
          Featured Digital Objects
        </h2>
      </div>

      <div class="related-records">
        {resolvedObjects.map((record) => (
          <article class="related-record">
            <div class="related-record__header">
              <p class="related-record-id">
                <a href={`/fwx/${record.data.fwxId}`}>
                  {record.data.fwxId}
                </a>
              </p>

              <span class="record-badge">
                {record.data.objectType}
              </span>
            </div>

            <h3>
              <a href={`/fwx/${record.data.fwxId}`}>
                {record.data.title}
              </a>
            </h3>

            <p class="related-record__summary">
              {record.data.summary}
            </p>

            <a
              class="related-record__link"
              href={`/fwx/${record.data.fwxId}`}
            >
              Access Public Record →
            </a>
          </article>
        ))}
      </div>
      {resolvedObjects.length === 0 && <p>No Digital Objects are currently available in this collection.</p>}
      {missingObjects.map((missingId) => <p class="collection-unavailable">{missingId} — Digital Object unavailable in the public catalogue.</p>)}
    </section>

    <section
      class="record-section"
      aria-labelledby="related-publications"
    >
      <div class="record-section-heading">
        <p class="section-label">Supporting Documentation</p>

        <h2 id="related-publications">
          Related Publications
        </h2>
      </div>

      <div class="publication-list">
        {resolvedPublications.map((publication) => (
          <PublicationCard publication={publication} />
        ))}
      </div>
      {resolvedPublications.length === 0 && <p>No supporting publications are currently available for this collection.</p>}
      {missingPublications.map((missingId) => <p class="collection-unavailable">{missingId} — Publication unavailable in the public register.</p>)}
    </section>

  {(resolvedCollections.length > 0 || missingCollections.length > 0) && (
    <section class="record-section" aria-labelledby="related-collections">
      <div class="record-section-heading">
        <p class="section-label">Related Collections</p>
        <h2 id="related-collections">Further Curated Collections</h2>
      </div>
      <div class="related-records">
        {resolvedCollections.map((related) => <CollectionCard collection={related} />)}
      </div>
      {missingCollections.map((missingId) => <p class="collection-unavailable">{missingId} — Collection unavailable in the public register.</p>)}
    </section>
  )}

  {tags.length > 0 && (
    <section class="record-section" aria-labelledby="collection-tags">
      <h2 id="collection-tags">Tags</h2>

      <ul class="record-tags">
        {tags.map((tag: string) => (
          <li>{tag}</li>
        ))}
      </ul>
    </section>
  )}
</article>

<style>
  .collection-record { min-width: 0; overflow-wrap: anywhere; }
  @media (min-width: 761px) {
    .collection-record .fwx-document-control { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .collection-timeline {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brass);
  }
  .collection-timeline li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem;
  }
  .collection-timeline li + li { border-top: 1px solid var(--color-border); }
  .collection-timeline__date { font-family: var(--font-mono); font-weight: bold; }
  .collection-timeline p { margin: 0.25rem 0 0; font-size: 0.85rem; }
  .collection-unavailable { color: var(--color-muted); font-size: 0.9rem; }
  @media (max-width: 760px) {
    .collection-record :global(.related-record__header) { flex-wrap: wrap; }
    .collection-record :global(.publication-entry) { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .collection-record :global(.publication-entry__format) { flex-wrap: wrap; padding: 0; }
  }
  @media (max-width: 460px) {
    .collection-timeline li { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
  }
</style>
